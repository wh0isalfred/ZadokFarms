NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Stable random server-only secret for retry HMACs (at least 32 characters).
# Keep stable across deployments so pending requests remain recoverable.
# The order route uses the publishable key above, never a service-role key.
ORDER_REQUEST_HASH_SECRET=
