NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Stable random server-only secret for retry HMACs (at least 32 characters).
# Keep stable across deployments so pending requests remain recoverable.
# The order route uses the publishable key above, never a service-role key.
ORDER_REQUEST_HASH_SECRET=

# Server-only WhatsApp Business destination, in full international format.
# Use country code + national number (7-15 digits), optionally prefixed with +.
# Spaces, parentheses and hyphens are accepted; no local leading 0, 00 prefix,
# extensions, URLs or placeholders. Set the real registered business number
# only in local/deployment secrets. Never use a NEXT_PUBLIC variable.
# Missing/invalid configuration hides the handoff link, not the recorded request.
ZADOK_WHATSAPP_BUSINESS_NUMBER=

# Trusted canonical site origin for staff magic-link callbacks and POST origin checks.
# HTTPS in deployment; http://localhost:3000 is allowed for local development.
# No path, query or fragment. Also configure Supabase Auth redirect allow-list.
ZADOK_SITE_URL=
